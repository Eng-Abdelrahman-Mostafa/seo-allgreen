<?xml version="1.0" encoding="UTF-8"?>
<!-- Static routes, BY HAND, trailing-slash form, same list as seo.config.mjs
     staticRoutes. prerender.mjs appends each dynamic URL that actually rendered.
     Never list a URL that redirects, is noindex, or needs login. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://example.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://example.com/about/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
